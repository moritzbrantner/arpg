# Native server process environment. No automatic dotenv loading is provided.
# Export these values before running `cargo run -p arpg-game-server --bin server`.
ARPG_SERVER_PORT=4433
ARPG_SERVER_CERT_PEM=cert.pem
ARPG_SERVER_KEY_PEM=key.pem
ARPG_SERVER_SESSION_PATH=/arpg
ARPG_SERVER_DRAIN_GRACE_MS=500
# Invalid numeric values cause startup to fail instead of selecting a default.

# Optional recovery file; unset disables persistence. The parent must exist.
# ARPG_SERVER_RECOVERY_PATH=.local/recovery.json

# Optional unsigned 32-bit seed; unset generates a fresh seed on server startup.
# ARPG_RUN_SEED=12345

# Optional physics workload evidence directories used by arpg-core tests.
# ARPG_PHYSICS_TRACE_DIR=.local/physics-traces
# ARPG_PHYSICS_REFERENCE_DIR=.local/physics-reference
