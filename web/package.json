{
  "name": "arpg-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor-foundations.mjs",
    "wasm": "wasm-pack build ../crates/arpg-web-wasm --target web --out-dir ../../web/src/wasm --out-name arpg_web_wasm -- --locked",
    "test": "bun test src/virtual-stick.test.js src/dedicated-session.test.js src/jsx-runtime.test.js src/character-selection.test.js src/training-arena.test.js",
    "build": "bun run vendor && bun run wasm && vite build",
    "dev": "bun run vendor && bun run wasm && vite",
    "test:physics-wasm": "bun ../scripts/test-physics-wasm.mjs src/wasm/arpg_web_wasm.js"
  },
  "dependencies": {
    "@moritzbrantner/three-d-renderer": "github:moritzbrantner/3d-lab#f484db8a3d2a7a555fa463eddf9c28790b240ce0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "vite": "7.1.5"
  },
  "packageManager": "bun@1.4.2"
}
